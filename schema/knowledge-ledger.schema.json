{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luahelenammc.github.io/3D-Cluster-Engine/schema/knowledge-ledger-1.0.schema.json",
  "title": "Knowledge Engine assertion ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledgerVersion",
    "datasetId",
    "assertions",
    "decisions"
  ],
  "properties": {
    "ledgerVersion": {
      "const": "1.0"
    },
    "datasetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceManifestFingerprint": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80
    },
    "assertions": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertionId",
          "status",
          "at"
        ],
        "properties": {
          "assertionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "enum": [
              "proposed",
              "accepted",
              "rejected",
              "needs_review"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "path",
        "fingerprint",
        "quote",
        "derivation"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "fingerprint": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80
        },
        "anchor": {
          "type": "string",
          "maxLength": 200
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "derivation": {
          "enum": [
            "explicit",
            "derived",
            "inferred"
          ]
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        },
        "sourceAsOf": {
          "type": "string",
          "format": "date-time"
        },
        "authorityTier": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionId",
        "subjectId",
        "predicate",
        "objectId",
        "relationFamily",
        "directed",
        "evidence",
        "epistemicStatus",
        "reviewStatus",
        "confidence",
        "extractedBy"
      ],
      "properties": {
        "assertionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "relationFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "directed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "epistemicStatus": {
          "enum": [
            "declared",
            "derived",
            "inferred",
            "contested",
            "superseded"
          ]
        },
        "reviewStatus": {
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "needs_review"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extractedBy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "version",
            "privacy",
            "recordedAt"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "chunkId": {
              "type": "string",
              "maxLength": 300
            },
            "model": {
              "type": "string",
              "maxLength": 200
            },
            "privacy": {
              "enum": [
                "local",
                "authorized-remote",
                "imported"
              ]
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
