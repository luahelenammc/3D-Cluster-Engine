{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luahelenammc.github.io/3D-Cluster-Engine/schema/query-packet-1.0.schema.json",
  "title": "Bounded Query Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packetVersion", "query", "datasetId", "createdAt", "nodes", "sources", "constraints"],
  "properties": {
    "packetVersion": { "const": "1.0" },
    "query": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "datasetId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "createdAt": { "type": "string", "format": "date-time" },
    "nodes": {
      "type": "array", "maxItems": 8,
      "items": { "type": "object", "additionalProperties": false, "required": ["nodeId", "label", "cluster", "score", "excerpt"], "properties": { "nodeId": { "type": "string", "minLength": 1, "maxLength": 500 }, "label": { "type": "string", "maxLength": 300 }, "cluster": { "type": "string", "maxLength": 200 }, "score": { "type": "number", "minimum": 0 }, "excerpt": { "type": "string", "maxLength": 500 } } }
    },
    "sources": {
      "type": "array", "maxItems": 8,
      "items": { "type": "object", "additionalProperties": false, "required": ["sourceId", "path", "fingerprint", "excerpt", "score"], "properties": { "sourceId": { "type": "string", "minLength": 1, "maxLength": 2048 }, "path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "fingerprint": { "type": "string", "minLength": 8, "maxLength": 80 }, "anchor": { "type": "string", "maxLength": 200 }, "excerpt": { "type": "string", "maxLength": 520 }, "score": { "type": "number", "minimum": 0 } } }
    },
    "constraints": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 500 } }
  }
}
