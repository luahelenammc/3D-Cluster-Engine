{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luahelenammc.github.io/3D-Cluster-Engine/schema/query-answer-1.0.schema.json",
  "title": "Evidence-Bound Query Answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "nodeIds", "sourceRefs"],
  "properties": {
    "answer": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "nodeIds": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
    "sourceRefs": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["sourceId", "path"], "properties": { "sourceId": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1, "maxLength": 1024 }, "anchor": { "type": "string", "maxLength": 200 } } } },
    "uncertainty": { "type": "string", "maxLength": 4000 }
  }
}
