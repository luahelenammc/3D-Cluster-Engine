{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luahelenammc.github.io/3D-Cluster-Engine/schema/source-manifest-1.0.schema.json",
  "title": "Markdown Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "adapter", "vaultId", "createdAt", "fingerprint", "capabilities", "sources"],
  "properties": {
    "manifestVersion": { "const": "1.0" },
    "adapter": { "const": "markdown-vault" },
    "vaultId": { "type": "string", "minLength": 8, "maxLength": 100 },
    "createdAt": { "type": "string", "format": "date-time" },
    "fingerprint": { "type": "string", "minLength": 8, "maxLength": 80 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "diff", "stableIds", "anchors", "directWrite", "patchExport", "renameAwareness"],
      "properties": {
        "read": { "const": true }, "diff": { "const": true }, "stableIds": { "const": true }, "anchors": { "const": true },
        "directWrite": { "const": false }, "patchExport": { "const": true }, "renameAwareness": { "const": true }
      }
    },
    "sources": {
      "type": "array", "maxItems": 2000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "adapter", "path", "title", "fingerprint", "headings", "tags", "frontmatter", "links", "content", "byteLength", "provenance"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "adapter": { "const": "markdown-vault" },
          "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.[mM][dD]$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 500 },
          "fingerprint": { "type": "string", "minLength": 8, "maxLength": 80 },
          "modifiedAt": { "type": "string", "format": "date-time" },
          "headings": { "type": "array", "maxItems": 500, "items": { "type": "object", "additionalProperties": false, "required": ["depth", "text", "anchor"], "properties": { "depth": { "type": "integer", "minimum": 1, "maximum": 6 }, "text": { "type": "string", "minLength": 1, "maxLength": 1000 }, "anchor": { "type": "string", "minLength": 1, "maxLength": 120 } } } },
          "tags": { "type": "array", "uniqueItems": true, "maxItems": 500, "items": { "type": "string", "maxLength": 200 } },
          "frontmatter": { "type": "object", "maxProperties": 200 },
          "links": { "type": "array", "maxItems": 5000, "items": { "type": "object", "additionalProperties": false, "required": ["target", "kind", "resolution"], "properties": { "target": { "type": "string", "maxLength": 1024 }, "anchor": { "type": "string", "maxLength": 200 }, "fromAnchor": { "type": "string", "maxLength": 200 }, "kind": { "enum": ["wikilink", "markdown"] }, "resolvedSourceId": { "type": "string" }, "resolution": { "enum": ["resolved", "missing", "ambiguous"] }, "candidates": { "type": "array", "items": { "type": "string" } } } } },
          "content": { "type": "string", "maxLength": 5242880 },
          "byteLength": { "type": "integer", "minimum": 0, "maximum": 5242880 },
          "provenance": { "type": "object", "additionalProperties": false, "required": ["kind", "capturedAt"], "properties": { "kind": { "const": "user-selected-local-file" }, "capturedAt": { "type": "string", "format": "date-time" } } }
        }
      }
    }
  }
}
